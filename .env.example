NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-here
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here
# Bearer token guarding /api/cleanup (Vercel Cron sends it automatically).
# Generate with `openssl rand -hex 32`; set the same value in Vercel env.
CRON_SECRET=cron-secret-here
# Public URL phones use to join, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
